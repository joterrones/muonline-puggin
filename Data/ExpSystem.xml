	<!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
		<Range MinReset="2" MaxReset="100" MinLevel="1" MaxLevel="100" NormalExp="2000.0" MasterExp="2000.0" MajesticExp="4000.0" OffLevelExp="1.0"/>
		<Range MinReset="2" MaxReset="100" MinLevel="101" MaxLevel="400" NormalExp="2000.0" MasterExp="2000.0" MajesticExp="4000.0" OffLevelExp="1.0"/>
		<Range MinReset="2" MaxReset="100" MinLevel="401" MaxLevel="800" NormalExp="3000.0" MasterExp="3000.0" MajesticExp="6000.0" OffLevelExp="1.0"/>
		<Range MinReset="2" MaxReset="100" MinLevel="801" MaxLevel="1200" NormalExp="3000.0" MasterExp="3000.0" MajesticExp="6000.0" OffLevelExp="1.0"/>
